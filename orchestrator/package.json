{
  "name": "officepal-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "OfficePal MVP — Track 2: Agent SDK orchestrator (the \"brain\"). Separate Node service, deployed on Fly.io/Render. See BUILD-CONTRACT.md.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
