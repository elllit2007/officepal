# Copy to .env for local development. In production these are set as
# platform secrets (see README.md) — never committed.

PORT=8787

# Supabase project URL and SERVICE ROLE key (not the anon key). The service
# role key bypasses Row Level Security, which is required because the
# orchestrator writes across tenants. Never expose it to a client/browser.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Used by the Claude Agent SDK to run the orchestration agent.
ANTHROPIC_API_KEY=

# Shared secret Next.js API routes (Track 3/4) must send as the
# `x-orchestrator-token` header. The orchestrator is not meant to be called
# directly by browsers/field staff — only by trusted server-side callers.
ORCHESTRATOR_SHARED_SECRET=
